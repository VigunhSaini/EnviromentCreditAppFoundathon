# ============================================================
# Environmental Credits Platform — Backend Environment Template
# ============================================================
# Copy this file to .env and fill in all <TO_BE_PROVIDED> values
# before starting the server.
#
# NEVER commit the real .env file to version control.
# ============================================================

# ----------------------------------------------------------
# Flask
# ----------------------------------------------------------
FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=True

# ----------------------------------------------------------
# Supabase  (already configured — do not change)
# ----------------------------------------------------------
SUPABASE_URL=<YOUR_SUPABASE_PROJECT_URL>
SUPABASE_KEY=<YOUR_SUPABASE_ANON_OR_SERVICE_ROLE_KEY>

# ----------------------------------------------------------
# Ethereum / Sepolia Testnet
# ----------------------------------------------------------
# Get a free RPC URL from: https://app.infura.io  or  https://alchemy.com
ETH_RPC_URL=<TO_BE_PROVIDED>

# The private key of the admin/deployer wallet (no 0x prefix needed)
# ⚠️  Keep this SECRET — it controls the contract owner account.
WALLET_PRIVATE_KEY=<TO_BE_PROVIDED>

# The address of the deployed EnvironmentalCredit contract on Sepolia
# Fill this in AFTER you run: npx hardhat run scripts/deploy.js --network sepolia
CONTRACT_ADDRESS=<TO_BE_PROVIDED>
